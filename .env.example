# Copier ce fichier en .env et adapter. Ne jamais committer .env.

# Dossier contenant train.jsonl, test.jsonl, telecom_taxonomy.json (ingestion locale).
# Par défaut : le dossier parent du dépôt (configs/data.yaml -> source.local_dir).
DARIJACARE_SOURCE_DIR=

# Jeton Hugging Face (facultatif : les dépôts utilisés sont publics).
HF_TOKEN=

# PostgreSQL (docker-compose)
POSTGRES_USER=darijacare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=darijacare
POSTGRES_PORT=5432

# MLflow (docker-compose)
MLFLOW_PORT=5000
MLFLOW_DB=mlflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Qdrant (docker-compose)
QDRANT_PORT=6333

# Base de données de l'API : DATABASE_URL prime ; sinon l'URL est construite à partir de
# POSTGRES_* ci-dessus (hôte POSTGRES_HOST, 127.0.0.1 par défaut).
# DATABASE_URL=postgresql+psycopg://darijacare:<mot-de-passe>@127.0.0.1:5432/darijacare
POSTGRES_HOST=127.0.0.1

# Serveur Qdrant utilisé par l'API (docker-compose). Vide : mode local embarqué (un seul processus).
QDRANT_URL=http://127.0.0.1:6333

# Clé de signature des jetons (32 caractères minimum). Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=15
SESSION_TTL_HOURS=24
# Origines autorisées (CORS), au format JSON : l'interface Vite en développement.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
